{
  "name": "@sveltia/ui",
  "version": "0.65.2",
  "description": "A collection of Svelte components and utilities for building user interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltia/sveltia-ui.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kohei Yoshino",
    "url": "https://github.com/kyoshino"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locales/*": "./dist/locales/*",
    "./shiki-engine": "./dist/shiki-engine.js"
  },
  "svelte": "./dist/index.js",
  "typesVersions": {
    ">4.0": {
      "index": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run generate:shiki && svelte-kit sync && svelte-package && node scripts/build-shiki-engine.js",
    "build:watch": "svelte-kit sync && svelte-package --watch",
    "check": "pnpm run '/^check:.*/'",
    "check:audit": "pnpm audit",
    "check:cspell": "cspell --no-progress",
    "check:eslint": "eslint .",
    "check:oxlint": "oxlint .",
    "check:prettier": "prettier --check .",
    "check:stylelint": "stylelint '**/*.{css,scss,svelte}'",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write .",
    "generate:emoji": "node scripts/generate-emoji-data.js",
    "generate:shiki": "node scripts/generate-shiki-metadata.js",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lexical/code-core": "^0.49.0",
    "@lexical/dragon": "^0.49.0",
    "@lexical/extension": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.49.0",
    "@lexical/markdown": "^0.49.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.49.0",
    "@lexical/table": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "@sveltia/i18n": "^1.2.3",
    "@sveltia/utils": "^0.12.1",
    "lexical": "^0.49.0"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^5.0.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.1.0",
    "eslint-plugin-package-json": "^1.7.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "oxlint": "^1.78.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "rolldown": "^1.2.4",
    "sass": "^1.102.0",
    "shiki": "^4.4.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.2.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
