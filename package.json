{
  "name": "@sveltia/ui",
  "version": "0.79.4",
  "description": "A collection of Svelte components and utilities for building user interfaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sveltia/sveltia-ui.git"
  },
  "license": "MIT",
  "author": {
    "name": "Kohei Yoshino",
    "url": "https://github.com/kyoshino"
  },
  "sideEffects": false,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./locales/*": "./dist/locales/*",
    "./self-hosted": {
      "types": "./dist/self-hosted/index.d.ts",
      "default": "./dist/self-hosted/index.js"
    },
    "./shiki-engine": {
      "types": "./dist/shiki-engine.d.ts",
      "default": "./dist/shiki-engine.js"
    }
  },
  "svelte": "./dist/index.js",
  "typesVersions": {
    ">4.0": {
      "index": [
        "./dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-utils"
  ],
  "scripts": {
    "build": "npm run generate:shiki && npm run generate:fonts && svelte-kit sync && svelte-package && node scripts/build-shiki-engine.js",
    "build:watch": "svelte-kit sync && svelte-package --watch",
    "check": "pnpm run --no-bail '/^check:.*/'",
    "check:audit": "pnpm audit --ignore-registry-errors",
    "check:cspell": "cspell --no-progress",
    "check:eslint": "eslint .",
    "check:oxlint": "oxlint .",
    "check:prettier": "prettier --check .",
    "check:stylelint": "stylelint '**/*.{css,scss,svelte}'",
    "check:svelte": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write .",
    "generate:emoji": "node scripts/generate-emoji-data.js",
    "generate:fonts": "node scripts/copy-fonts.js",
    "generate:shiki": "node scripts/generate-shiki-metadata.js",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lexical/code-core": "^0.52.0",
    "@lexical/dragon": "^0.52.0",
    "@lexical/extension": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/table": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@sveltia/i18n": "^1.4.1",
    "@sveltia/utils": "^0.12.3",
    "lexical": "^0.52.0"
  },
  "devDependencies": {
    "@fontsource-variable/material-symbols-outlined": "5.3.8",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/noto-mono": "5.3.0",
    "@rollup/plugin-yaml": "^5.0.0",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "cspell": "^10.3.6",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-package-json": "^1.10.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.87.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.29",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "rolldown": "^1.2.12",
    "sass": "^1.105.1",
    "shiki": "^4.5.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-scss": "^7.3.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
